---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Krabuś, Krówka i ich wędrówka',
  description = 'Przygody Krabusia, Krówki i spółki.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase('og-image.png'), Astro.site);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Krabuś, Krówka i ich wędrówka',
  description,
  url: canonical.href,
  inLanguage: 'pl-PL',
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d8d5cc" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Krabuś, Krówka i ich wędrówka" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Krabuś, Krówka i ich wędrówka — Przygody Krabusia, Krówki i spółki." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Krabuś, Krówka i ich wędrówka — Przygody Krabusia, Krówki i spółki." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Krabuś, Krówka i ich wędrówka" href={withBase('rss.xml')} />
    {import.meta.env.DEV && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Alegreya:wght@400;500&family=Cardo:wght@400;700&family=Cormorant+Garamond:wght@400;500&family=Crimson+Pro:wght@400;500&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Lora:wght@400;500&family=Merriweather:wght@400;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=Playfair+Display:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500&display=swap"
          rel="stylesheet"
        />
      </>
    )}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="container site-header">
      <a class="brand" href={withBase()} aria-label="Krabuś, Krówka i ich wędrówka — strona główna">
        <img src={withBase('krabus-krowka.webp')} alt="" width="48" height="48" aria-hidden="true" />
        <h1>Krabuś, Krówka i ich wędrówka</h1>
      </a>
    </header>
    <main id="tresc" tabindex="-1"><slot /></main>
    {import.meta.env.DEV && (
      <aside class="font-tester" aria-live="polite" aria-label="Tester krojów pisma">
        <span class="font-tester__hint">Klawisze 1–9, 0</span>
        <strong id="font-tester-name">1 — Newsreader</strong>
      </aside>
    )}
    {import.meta.env.DEV && (
      <script is:inline>
        const fonts = {
          '1': ['Newsreader', '"Newsreader", Georgia, serif'],
          '2': ['Lora', '"Lora", Georgia, serif'],
          '3': ['Alegreya', '"Alegreya", Georgia, serif'],
          '4': ['Crimson Pro', '"Crimson Pro", Georgia, serif'],
          '5': ['Source Serif 4', '"Source Serif 4", Georgia, serif'],
          '6': ['Cormorant Garamond', '"Cormorant Garamond", Georgia, serif'],
          '7': ['Fraunces', '"Fraunces", Georgia, serif'],
          '8': ['Cardo', '"Cardo", Georgia, serif'],
          '9': ['Merriweather', '"Merriweather", Georgia, serif'],
          '0': ['Playfair Display', '"Playfair Display", Georgia, serif'],
        };

        const label = document.querySelector('#font-tester-name');

        const selectFont = (key) => {
          const font = fonts[key];
          if (!font) return;
          document.documentElement.style.setProperty('--serif', font[1]);
          label.textContent = `${key} — ${font[0]}`;
        };

        selectFont('1');
        window.addEventListener('keydown', (event) => {
          const target = event.target;
          if (target instanceof HTMLElement && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) return;
          selectFont(event.key);
        });
      </script>
    )}
  </body>
</html>

<style>
  .font-tester {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: grid;
    gap: 0.1rem;
    min-width: 13rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--paper) 92%, white);
    box-shadow: 0 0.5rem 2rem rgba(65, 67, 62, 0.14);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.35;
  }

  .font-tester__hint {
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .font-tester strong {
    font-size: 0.92rem;
    font-weight: 600;
  }
</style>
