---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Krabuś, Krówka i ich wędrówka',
  description = 'Przygody Krabusia, Krówki i spółki.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase('og-image.png'), Astro.site);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Krabuś, Krówka i ich wędrówka',
  description,
  url: canonical.href,
  inLanguage: 'pl-PL',
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d8d5cc" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Krabuś, Krówka i ich wędrówka" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Krabuś, Krówka i ich wędrówka — Przygody Krabusia, Krówki i spółki." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Krabuś, Krówka i ich wędrówka — Przygody Krabusia, Krówki i spółki." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title="Krabuś, Krówka i ich wędrówka" href={withBase('rss.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cardo:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="container site-header">
      <a class="brand" href={withBase()} aria-label="Krabuś, Krówka i ich wędrówka — strona główna">
        <img src={withBase('krabus-krowka.webp')} alt="" width="48" height="48" aria-hidden="true" />
        <h1>Krabuś, Krówka i ich wędrówka</h1>
      </a>
    </header>
    <main id="tresc" tabindex="-1"><slot /></main>
  </body>
</html>
